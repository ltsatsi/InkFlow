@model DomainLayer.Dtos.Blog.BlogDto

@{
    ViewData["Title"] = "Details";
}

<a asp-action="Index" class="text-decoration-none text-dark">
    <div class="d-flex mt-4">
        <i class="bi bi-arrow-left"></i>
        <p class="text-muted ms-2">All Posts</p>
    </div>
</a>


<div>
    <div class="d-flex justify-content-between align-items-center">
        <p class="text-secondary">
            <span style="color: peru;">@Model.Category</span> ·
            @Model.CreatedOn.ToString("MMM dd, yyyy") ·
            @Model.ReadTime min read
        </p>
        <p class="text-secondary">
            @Model.Comments.Count<i class="ms-2 bi bi-chat"></i>
        </p>
    </div>

    <h1 class="display-6 mb-3" style="font-weight: 500;">@Model.Title</h1>
    <p class="text-muted lead">@Model.Summary</p>
</div>


<hr class="mt-5 mb-4 text-muted" />

<div class="d-flex justify-content-between align-items-center mb-2">
    <p class="m-0 p-0">By <strong>@Model.Author.FullName</strong></p>
    <a class="btn btn-sm btn-outline-dark rounded-pill"
       onclick="copyLink('@Url.Action("Details", "Blog", new { id = Model.Id }, Context.Request.Scheme)')"
       id="copyBtn">
       <i class="bi bi-link-45deg"></i> Copy link
   </a>
</div>

<hr class="mb-4 text-muted" />

<img src="@Model.ImageUrl" class="img-fluid rounded-3 mb-4" />

<div>
    @Html.Raw(Model.Content)
</div>

<hr class="mt-5 mb-4 text-muted" />


<!-- comments section -->

<h4 class="mb-4">Comments</h4>

<div class="mb-5">
    <form asp-action="Create" asp-controller="Comment" method="post">
		<input type="hidden" name="BlogId" value="@Model.Id" />
        <div class="d-flex gap-2 form-group">
            <input type="text" name="Content" class="form-control rounded-pill" placeholder="Add a comment ..." />
            <input type="submit" class="btn btn-sm btn-dark rounded-pill" value="Comment" />
        </div>
    </form>
</div>


@foreach(var comment in Model.Comments)
{
    <div class="d-flex justify-content-between">
        <div>
            <h6>@(comment.AppUser?.FullName ?? "Anonymous")</h6>
            <p>@comment.Content</p>
        </div>

        <a asp-action="Delete"
           asp-controller="Comment"
           asp-route-id="@comment.Id"
           class="text-dark">
            <i class="bi bi-trash pe-4"></i>
        </a>
    </div>

    if (comment != Model.Comments.Last())
    {
        <hr class="mb-3 text-muted" />
    }
}


<script>
    function copyLink(url) {
        navigator.clipboard.writeText(url);

        const btn = document.getElementById("copyBtn");
        btn.innerText = "Link Copied";
        btn.className = "btn btn-sm btn-success rounded-pill";

        setTimeout(() => {
            btn.innerHTML = "<i class='bi bi-link-45deg'></i> Copy Link";
        btn.className = "btn btn-sm btn-outline-dark rounded-pill";
        }, 2000);
    }
</script>