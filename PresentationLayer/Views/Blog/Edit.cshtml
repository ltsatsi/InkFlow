@using DomainLayer.Models
@model DomainLayer.Dtos.Blog.BlogDto

@{
    ViewData["Title"] = "Edit";
}

@if (ViewBag.Errors != null)
{
    <div class="alert alert-danger">
        @ViewBag.Errors
    </div>
}

<div class="my-5">
    <h4 style="font-weight: 500;">@Model.Title</h4>
    <p class="text-muted fw-light">Ensure you save all changes before exiting the page</p>
</div>

<div class="row">
    <div class="col">
        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="Id" hidden />
            <input asp-for="AuthorId" hidden />
            <input asp-for="ReadTime" hidden />
            <input asp-for="ImageUrl" hidden />



            <div class="row mb-3">
                <div class="col form-group">
                    <label asp-for="Title" class="control-label mb-2 fw-bold"></label>
                    <input asp-for="Title" class="form-control" placeholder="A title worth clicking" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>


                <div class="col form-group">
                    <label asp-for="Category" class="control-label mb-2 fw-bold"></label>
                    <select asp-for="Category"
                            asp-items="Html.GetEnumSelectList<Category>()"
                            class="form-control">
                    </select>
                    <span asp-validation-for="Category" class="text-danger"></span>
                </div>
            </div>



            <div class="form-group mb-3">
                <label asp-for="ImageUrl" class="control-label mb-2 fw-bold"></label>

                <div id="uploadBox">
                    <img src="/images/icons/upload_file.png" id="preview" class="mb-4" width="100" />
                    <p id="uploadText">
                        Click to upload or drag and drop <br>
                        <span class="text-muted">Maximum file size 50MB</span>
                    </p>

                    <input type="file" name="ImageFile" id="imageInput" hidden />
                </div>
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>


            <div class="form-group mb-3">
                <label asp-for="Summary" class="control-label mb-2 fw-bold"></label>
                <input asp-for="Summary" class="form-control" />
                <span asp-validation-for="Summary" class="text-danger"></span>
            </div>



            <div class="form-group mb-3">
                <label asp-for="Content" class="control-label mb-2 fw-bold"></label>
                <input type="hidden" asp-for="Content" id="existingContent" value="@Model.Content" />
                <div id="quillEditor" style="height: 250px; background: #fff;"
                     class="border rounded"></div>
                <span asp-validation-for="Content" class="text-danger small"></span>
            </div>


            <div class="d-flex gap-3 align-items-center form-group mb-5">
                <input type="submit" value="Save" class="btn btn-dark rounded-pill" />
                <a asp-action="Index" class="text-decoration-none text-muted">Cancel</a>
            </div>
        </form>
    </div>
</div>


<link href="https://cdn.quilljs.com/1.3.6/quill.snow.css" rel="stylesheet" />
<script src="https://cdn.quilljs.com/1.3.6/quill.min.js"></script>

<style>
    #uploadBox {
        border: 1.5px dashed #ccc;
        background: #f8f9fa;
        border-radius: 8px;
        padding: 30px;
        cursor: pointer;
        text-align: center;
    }

    #uploadBox:hover {
        border: 1.5px dashed #000;
        transition: .3s ease-in;
    }
</style>


<script>
    const dropBox = document.getElementById("uploadBox");
    const fileInput = document.getElementById("imageInput");
    const uploadText = document.getElementById("uploadText");
    const preview = document.getElementById("preview");

    dropBox.addEventListener("click", () => {
        fileInput.click();
    });

    // Prevent browser opening file
    ["dragenter", "dragover", "dragleave", "drop"].forEach(eventName => {
        dropBox.addEventListener(eventName, e => {
            e.preventDefault();
            e.stopPropagation();
        });
    });

    dropBox.addEventListener("dragover", () => {
        dropBox.style.borderColor = "#0D6EFD";
    });

    dropBox.addEventListener("dragleave", () => {
        dropBox.style.borderColor = "#ccc";
    });

    dropBox.addEventListener("drop", e => {

        e.preventDefault();

        const files = e.dataTransfer.files;

        if (files.length > 0) {
            fileInput.files = files;
            handleFile(files[0]);
        }

        dropBox.style.borderColor = "#ccc";
    });

    fileInput.addEventListener("change", function () {
        const file = this.files[0];
        handleFile(file);
    });

    function handleFile(file) {

        if (!file)
            return;

        uploadText.textContent = `${file.name}`;

        const reader = new FileReader();

        reader.onload = function (e) {
            preview.src = e.target.result;
        };

        reader.readAsDataURL(file);
    }

    const existingImage = "@Model.ImageUrl";

    if (existingImage) {
        preview.src = existingImage;
        uploadText.textContent = `Existing Image`;
    }

    // Quill Section
    var quill = new Quill('#quillEditor', {
        theme: 'snow',
        placeholder: 'Start writing your article here ...',
        modules: {
            toolbar: [
                [{ header: [1, 2, 3, 4, false] }],
                ['bold', 'italic', 'underline'],
                [{ list: 'ordered' }, { list: 'bullet' }],
                ['blockquote', 'code-block'],
            ]
        }
    });

    // Sync content to hidden input before form submit
    var form = document.querySelector("form");
    form.onsubmit = function () {
        document.getElementById("content").value = quill.root.innerHTML;
    };

    var existing = document.getElementById("existingContent").value;

    if (existing) {
        quill.root.innerHTML = existing;
    }
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
