@model IEnumerable<DomainLayer.Dtos.Blog.BlogDto>

@{
    ViewData["Title"] = "Posts";
}


<div class="row mt-5 px-3">
    <div class="col-12 col-lg-4 ps-2 order-1 order-lg-2">
        <div class="mb-5">
            <form asp-action="Index" method="get">
                <div class="d-flex gap-2 mb-2">
                    <input class="form-control rounded-pill"
                           name="Search"
                           value="@ViewData["CurrentSearch"]"
                           autoComplete="off"
                           placeholder="Search posts" />

                    <input type="submit" value="Search" class="btn btn-default" />
                </div>
            </form>

            <div class="mt-1">
                <a asp-action="Index"
                   class="badge border bg-black text-white rounded-pill">
                    All
                </a>

                <a asp-action="Index"
                   asp-route-Category="Reading"
                   asp-route-Search="@ViewData["CurrentSearch"]"
                   class="badge border text-black rounded-pill">
                    Reading
                </a>

                <a asp-action="Index"
                   asp-route-Category="Finance"
                   asp-route-Search="@ViewData["CurrentSearch"]"
                   class="badge border text-black rounded-pill">
                    Finance
                </a>

                <a asp-action="Index"
                   asp-route-Category="Heatlh"
                   asp-route-Search="@ViewData["CurrentSearch"]"
                   class="badge border text-black rounded-pill">
                    Health
                </a>

                <a asp-action="Index"
                   asp-route-Category="Lifestyle"
                   asp-route-Search="@ViewData["CurrentSearch"]"
                   class="badge border text-black rounded-pill">
                    Lifestyle
                </a>

                <a asp-action="Index"
                   asp-route-Category="Technology"
                   asp-route-Search="@ViewData["CurrentSearch"]"
                   class="badge border text-black rounded-pill">
                    Techonolgy
                </a>

                <a asp-action="Index"
                   asp-route-Category="Innovation"
                   asp-route-Search="@ViewData["CurrentSearch"]"
                   class="badge border text-black rounded-pill">
                    Innovation
                </a>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-8 pe-2 order-2 order-lg-1">
        @if(Model.Any())
        {
            @foreach (var blogDto in Model)
            {
                @if (blogDto == Model.First())
                {
                    <div>
                        <p class="text-muted">
                            <span style="color: brown;">@blogDto.Category</span> ·
                            @blogDto.CreatedOn.ToString("MMM dd, yyyy") ·
                            @blogDto.ReadTime min read
                        </p>

                        <h1>
                            <a asp-action="Details" asp-route-id="@blogDto.Id" id="blogTitle">
                                @blogDto.Title
                            </a>
                        </h1>

                        <p class="text-muted lead my-3">@blogDto.Summary</p>
                        <a asp-action="Details"
                           asp-route-id="@blogDto.Id"
                           style="font-weight: 700; font-size: 16px;"
                           class="text-decoration-none text-black">
                            Read the Post<i class="ms-3 bi bi-arrow-right"></i>
                        </a>
                    </div>
                }
                else
                {
                    <div>
                        <p class="text-muted">
                            <span style="color: peru;">@blogDto.Category</span> ·
                            @blogDto.CreatedOn.ToString("MMM dd, yyyy") ·
                            @blogDto.ReadTime min read
                        </p>

                        <h4>
                            <a asp-action="Details" asp-route-id="@blogDto.Id" id="blogTitle">
                                @blogDto.Title
                            </a>
                        </h4>

                        <p class="text-muted">@blogDto.Summary</p>
                    </div>
                }

                @if (blogDto != Model.Last())
                {
                    <hr class="my-4" />
                }
            }
        } else
        {
            <div class="text-center">
                <p>No posts yet ... <a asp-action="Create" asp-controller="Blog">Write a post</a></p>
                
            </div>
        }
    </div>
</div>



<style>
    #blogTitle {
        text-decoration: none;
        color: #000;
    }

    #blogTitle:hover {
        text-decoration: underline;
        color: #000;
    }

    .badge {
        padding: 10px 15px;
        font-size: 12px;
        font-weight: 100;
        margin-top: 10px;
		text-decoration: none;
	}

    .badge:hover {
		text-decoration: underline;
    }
</style>