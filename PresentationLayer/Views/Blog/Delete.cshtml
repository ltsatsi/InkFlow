@model DomainLayer.Dtos.Blog.BlogDto

@{
    ViewData["Title"] = "Delete";
}


<div class="mt-4">
    <h4>Delete @Model.Title</h4>
    <p class="text-muted">Please be adviced this action will permanently remove post from out database and this action cannot be undone.</p>

</div>

<hr class="mb-4 text-muted" />

<div class="d-flex justify-content-between align-items-center mb-2">
    <p class="m-0 p-0">By <strong>@Model.Author.FullName</strong></p>
</div>

<hr class="mb-4 text-muted" />

<div class="mt-5">
    @Html.Raw(Model.Content)
    
    <form asp-action="Delete">
        <div class="d-flex gap-3 align-items-center form-group mb-5">
            <input type="submit" value="Delete" class="btn btn-danger rounded-pill" />
            <a asp-action="Index" class="text-decoration-none text-muted">Cancel</a>
        </div>
    </form>
</div>
