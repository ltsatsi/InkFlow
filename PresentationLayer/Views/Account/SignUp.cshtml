@model DomainLayer.Dtos.Account.SignUpDto

@{
    ViewData["Title"] = "SignUp";
}

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col col-md-7 col-lg-4 p-5">
        <div class="mb-5 text-center">
            <h4>Create Account</h4>
            <p class="text-muted">Let's get started with your 30 days free trial</p>
        </div>

        @if (ViewBag.AddToRoleError != null)
        {
            <div class="alert alert-danger">
                @ViewBag.AddToRoleError
            </div>
        }

        <div>
            <form asp-action="SignUp">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group mb-3">
                    <label asp-for="FullName" class="control-label mb-1"></label>
                    <input asp-for="FullName" class="form-control mb-1" placeholder="Enter full name" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Email" class="control-label mb-1"></label>
                    <input asp-for="Email" class="form-control mb-1" placeholder="author@inkflow.com" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <label asp-for="Password" class="control-label mb-1"></label>
                    <input asp-for="Password" class="form-control mb-1" placeholder="Enter password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-group mb-4">
                    <label asp-for="ConfirmPassword" class="control-label mb-1"></label>
                    <input asp-for="ConfirmPassword" class="form-control mb-1" placeholder="Enter password" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <div class="form-group mb-3">
                    <input type="submit" value="Create Account" class="btn btn-dark w-100 rounded-pill" />
                </div>
                <div class="form-group mb-3">
                    <p class="text-center">Already have an account ? <a asp-area="" asp-controller="Account" asp-action="SignIn">Sign In</a></p>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
