@{
    ViewData["Title"] = "Home Page";
}

@if (!User.Identity!.IsAuthenticated)
{
	<div class="d-flex justify-content-center align-items-center flex-column" style="min-height: 80vh;">
		<p class="text-center" style="font-weight: 500; font-size: clamp(2rem, 5vw, 4rem);">Creative blog craft, writing <br /> In Seconds</p>
		<p class="text-muted text-center" style="font-size: clamp(1rem, 2vw, 1.25rem);"><strong>InkFlow</strong> is a small blog app. A short post, no feeds, no noise.</p>
		<a asp-controller="Account" asp-action="SignUp" class="btn btn-dark rounded-pill mt-3">Get Started<i class="bi bi-arrow-right ms-2"></i></a>
	</div>
}
else
{
	<div class="d-flex justify-content-center align-items-center flex-column" style="min-height: 80vh;">
		<div class=" p-2 w-100 text-center">Hi there! @User.Identity.Name</div>
	</div>
}
