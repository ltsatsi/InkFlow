@model PresentationLayer.ViewModels.DashBoardViewModel

@{
	ViewData["Title"] = "Dashboard";
}

<p class="display-6 p-0 m-0 mt-4">Dashboard</p>
<small>Manage your site activity and content interactions</small>

<div class="row mt-4">
	<div class="col col-md-6">
		<div class="card bg-transparent">
			<div class="card-body">
				<p>@Model.BlogCount</p>
				<small>Posts</small>
			</div>
		</div>
	</div>
	<div class="col col-md-6">
		<div class="card bg-transparent">
			<div class="card-body">
				<p>@Model.CommentCount</p>
				<small>Comments</small>
			</div>
		</div>
	</div>
</div>

<p class="display-6 p-0 m-0 mt-4">Posts</p>
<small>Browse through and manage all your posts</small>

@if (Model.Blogs.Any())
{
	<div class="table-responsive mt-4">
		<table class="table table-bordered align-middle">
			<thead class="bg-light">
				<tr>
					<th style="width: 70%;">Title</th>
					<th>Manage</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var blog in Model.Blogs)
				{
					<tr>
						<td class="text-nowrap">@blog.Title</td>
						<td class="text-nowrap">
							<a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-controller="Blog" asp-route-id="@blog.Id"><i class="bi bi-eye"></i> Details</a>
							<a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-controller="Blog" asp-route-id="@blog.Id"><i class="bi bi-pencil"></i> Edit</a>
							<a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-controller="Blog" asp-route-id="@blog.Id"><i class="bi bi-trash"></i> Delete</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
} else
{
	<div class="text-center mt-4">
		<p>No posts ...
	</div>
}

<p class="display-6 p-0 m-0 mt-4">Comments</p>
<small>Browse through and manage all your comments</small>

@if (Model.Comments.Any())
{
	<div class="table-responsive mt-4">
		<table class="table table-bordered align-middle">
			<thead class="bg-light">
				<tr>
					<th style="width: 70%;">Content</th>
					<th>Manage</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var comment in Model.Comments)
				{
					<tr>
						<td class="text-nowrap">@comment.Content</td>
						<td class="text-nowrap">
							<a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-controller="Blog" asp-route-id="@comment.BlogId"><i class="bi bi-eye"></i> Details</a>
							<a class="btn btn-sm btn-danger" asp-action="Delete" asp-controller="Comment" asp-route-id="@comment.Id"><i class="bi bi-trash"></i> Delete</a>
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}
else
{
	<div class="text-center mt-4">
		<p>No comments ...</p>
	</div>
}