<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/PresentationLayer.styles.css" asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Merriweather:wght@700&display=swap" rel="stylesheet">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light border-bottom py-3">
            <div class="container-fluid px-4">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Ink<span style="color: saddlebrown;">Flow</span></a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">

                    <ul class="navbar-nav mx-auto gap-lg-3">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="DashBoard" asp-action="Index">
                                <i class="bi bi-bar-chart me-2"></i>
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Blog" asp-action="Index">
                                <i class="bi bi-book me-2"></i>
                                Posts
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-controller="Blog" asp-action="Create">
                                <i class="bi bi-vector-pen me-2"></i>
                                Write
                            </a>
                        </li>
                    </ul>

                    @if (!User.Identity!.IsAuthenticated)
                    {
                        <div class="d-md-flex gap-2">
                            <a asp-controller="Account"
                               asp-action="SignIn"
                               class="btn btn-sm btn-default w-100">
                                Sign In
                            </a>

                            <a asp-controller="Account"
                               asp-action="SignUp"
                               class="btn btn-sm btn-dark rounded-pill w-100 mt-2">
                                Sign Up
                            </a>
                        </div>
                    }


                    @if (User.Identity.IsAuthenticated)
                    {
                        <form asp-area="" asp-controller="Account" asp-action="SignOut" method="post">
                            <input type="submit" value="Sign Out" class="btn btn-default w-100" />
                        </form>
                    }

                </div>

            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer">
        <div class="container">
            <div class="d-flex justify-content-between">
                <p><strong>InkFlow</strong>, minimal blogging platform</p>
                <p>&copy; @DateTimeOffset.UtcNow.Year</p>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
